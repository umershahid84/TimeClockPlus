# Copy this file to .env and fill in real values. Never commit .env.

# --- Database (MariaDB) ---
# Local example:  mysql://tcp_user:tcp_password@localhost:3306/timeclockplus
# Cloud example (PlanetScale/Aiven/etc. — use their connection string):
DATABASE_URL="mysql://tcp_user:tcp_password@localhost:3306/timeclockplus"

# --- Auth ---
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="8h"
BCRYPT_SALT_ROUNDS=12

# --- Password / OTC policy ---
TEMP_PASSWORD_EXPIRY_HOURS=72
PASSWORD_RESET_CODE_EXPIRY_MINUTES=15
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# --- Email (SMTP) ---
# Any SMTP provider works (e.g. a free tier from Brevo, Mailgun, SendGrid, or Gmail SMTP w/ app password).
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="apikey-or-username"
SMTP_PASSWORD="smtp-password"
EMAIL_FROM="TimeClockPlus <no-reply@example.com>"

# --- App ---
PORT=4000
CORS_ORIGIN="http://localhost:5173"
APP_BASE_URL="http://localhost:5173"
NODE_ENV="development"

# Default rounding precision for decimal hour calculations (payroll)
DECIMAL_HOURS_PRECISION=2
