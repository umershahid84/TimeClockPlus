# Copy this file to .env and fill in real values. Never commit .env.
# This single .env file configures the whole application (API + web app
# are one integrated process — there is no separate frontend .env).

# --- Database (MariaDB) ---
DB_HOST = localhost
DB_PORT = 3306
DB_NAME = tcp
DB_USER = account
DB_PASS = abcdefg
DB_DIALECT = mariadb

# --- Auth ---
JWT_SECRET = change-me-to-a-long-random-string
JWT_EXPIRES_IN = 10h
JWT_ALGORITHM = HS256
BCRYPT_SALT_ROUNDS = 12

# --- Password / one-time-code policy ---
TEMP_PASSWORD_EXPIRY_HOURS = 72
PASSWORD_RESET_CODE_EXPIRY_MINUTES = 15
MAX_FAILED_LOGIN_ATTEMPTS = 5
ACCOUNT_LOCKOUT_MINUTES = 15

# --- Email (SMTP) ---
# Set SEND_EMAILS=false to skip sending and just log emails to the console
# (useful for local development against an internal relay you don't have
# access to). TEST_EMAIL_USER, when set, overrides every recipient in
# non-production environments so test runs never email real employees.
SEND_EMAILS = true
EMAIL_HOST = 10.78.4.11
EMAIL_PORT = 25
EMAIL_SECURE = false
EMAIL_USER = noreply@portseattle.org
EMAIL_PASS =
EMAIL_SENDER = noreply@portseattle.org
TEST_EMAIL_USER = shahid.u@portseattle.org
# Internal relays often present a self-signed or EXPIRED certificate
# ("certificate has expired" / "self signed certificate" errors). That's
# fine on a trusted internal network - set this to false to accept it
# instead of failing every send. Set EMAIL_IGNORE_TLS=true if the relay
# doesn't use STARTTLS at all.
EMAIL_TLS_REJECT_UNAUTHORIZED = true
EMAIL_IGNORE_TLS = false

# --- App ---
PORT = 4000
CORS_ORIGIN = http://localhost:5173
APP_BASE_URL = http://localhost:5173
NODE_ENV = development

# Default rounding precision for decimal hour calculations (payroll)
DECIMAL_HOURS_PRECISION = 2

# IANA timezone the organization operates in. Every time shown to a user -
# UI, PDF/CSV/Excel reports, notifications, audit logs - is converted to
# this timezone. Timestamps remain stored in UTC in the database.
APP_TIMEZONE = America/Los_Angeles

# Any Sunday that starts a real Sunday-Saturday, 14-day pay period. Other
# pay periods are computed as 14-day offsets from this date.
PAY_PERIOD_ANCHOR = 2026-07-26
